{
 "uid": "reflexdesk",
 "title": "ReflexDesk",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "run_id",
    "type": "textbox",
    "query": ".*",
    "current": {
     "value": ".*"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Стоимость LLM за сутки, $",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(llm_cost_usd_total[1d]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "title": "Стоимость отчёта, $ (среднее)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(llm_cost_usd_total[1d])) / clamp_min(sum(increase(graph_runs_total{status=\"done\"}[1d])), 1)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "title": "Прогоны по статусу",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (increase(graph_runs_total[1h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "title": "Длительность прогона p50/p95, с",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(graph_run_duration_seconds_bucket[1h])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(graph_run_duration_seconds_bucket[1h])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "title": "Латентность LLM p95 по тирам, с",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(llm_latency_seconds_bucket[15m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 6,
   "title": "Токены по тирам",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tier, kind) (rate(llm_tokens_total[15m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 7,
   "title": "Доля отклонений Validator",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(validation_rejected_total[1h])) / clamp_min(sum(rate(graph_runs_total[1h])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 8,
   "title": "UNVALIDATED",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(validation_exhausted_total[1d]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 9,
   "title": "Gateway: доля fallback",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (gate) (rate(jev_fallback_total[1h])) / clamp_min(sum by (gate) (rate(gateway_decisions_total[1h])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 10,
   "title": "Gateway p95, мс",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 21
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.95, sum by (le, gate) (rate(gateway_latency_seconds_bucket[15m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 11,
   "title": "Ошибки тулов",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 21
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool) (rate(tool_calls_total{status=\"error\"}[15m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 12,
   "title": "Прогнозы pending / stale",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 21
   },
   "targets": [
    {
     "refId": "A",
     "expr": "predictions_pending",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "predictions_stale",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 13,
   "title": "Hit rate / Brier (self-eval)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 28
   },
   "targets": [
    {
     "refId": "A",
     "expr": "eval_score{suite=\"self_eval\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 14,
   "title": "Golden-set",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 28
   },
   "targets": [
    {
     "refId": "A",
     "expr": "eval_score{suite=~\"golden_.*\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 15,
   "title": "VRAM, %",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 28
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * vram_used_bytes / vram_total_bytes",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 99,
   "title": "Логи прогона",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 40
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"app\"} | json | run_id=~\"$run_id\"",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ]
}